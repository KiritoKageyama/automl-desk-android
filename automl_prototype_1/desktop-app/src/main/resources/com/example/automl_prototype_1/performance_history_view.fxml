<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="card" alignment="TOP_CENTER"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.automl_prototype_1.controller.PerformanceHistoryViewController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="📊 Algorithm Performance History" styleClass="header-label"/>
    <Label text="Track success/failure rates of algorithms across experiments." styleClass="sub-header-label" style="-fx-font-weight: normal; -fx-text-fill: gray;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="refreshBtn" text="🔄 Refresh" styleClass="button"/>
        <Button fx:id="clearHistoryBtn" text="🗑 Clear All History" styleClass="button" style="-fx-text-fill: #dc2626;"/>
    </HBox>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="400">
        <columns>
            <TableColumn fx:id="algorithmCol" text="Algorithm" prefWidth="200"/>
            <TableColumn fx:id="attemptsCol" text="Attempts" prefWidth="100"/>
            <TableColumn fx:id="successRateCol" text="Success Rate %" prefWidth="120"/>
            <TableColumn fx:id="failureRateCol" text="Failure Rate %" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: gray;"/>
</VBox>
