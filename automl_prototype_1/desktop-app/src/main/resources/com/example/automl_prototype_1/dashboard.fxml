<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:controller="com.example.automl_prototype_1.controller.DashboardController"
           xmlns:fx="http://javafx.com/fxml/1" prefWidth="1280" prefHeight="850"
           styleClass="root">

    <BorderPane>

    <!-- LEFT: Modern Sidebar Navigation -->
    <left>
        <VBox spacing="10" prefWidth="260" styleClass="left-sidebar">
            <padding><Insets top="30" right="20" bottom="30" left="20"/></padding>
            
            <!-- Logo / Brand Area -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets bottom="40"/></padding>
                <Label text="AutoML" styleClass="sidebar-title"/>
            </HBox>

            <!-- Navigation Items -->
            <Label text="MAIN MENU" styleClass="sub-header-label" style="-fx-font-size: 12px; -fx-text-fill: -color-text-secondary; -fx-padding: 0 0 10 10;"/>
            
            <Button fx:id="uploadBtn" text="Upload Dataset" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="algoBtn" text="Select Algorithm" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="settingsBtn" text="Settings" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="simulatorBtn" text="Pipeline Simulator" styleClass="nav-button" maxWidth="Infinity"/>

            <Region prefHeight="30"/>

            <Label text="ACTIONS" styleClass="sub-header-label" style="-fx-font-size: 12px; -fx-text-fill: -color-text-secondary; -fx-padding: 0 0 10 10;"/>
            <Button fx:id="runBtn" text="Run Experiment" styleClass="nav-button, button-accent" maxWidth="Infinity"/>
            <Button fx:id="resultsBtn" text="View Results" styleClass="nav-button" maxWidth="Infinity"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Bottom Actions -->
            <Button fx:id="exitBtn" text="Log Out" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- CENTER: Main Content Area with Header -->
    <center>
        <VBox spacing="0" styleClass="content-area">
            <!-- Header Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 30 10 30;">
                <VBox>
                    <Label text="Dashboard" styleClass="header-label"/>
                    <Label text="Welcome back, User" styleClass="sub-header-label" style="-fx-font-weight: normal;"/>
                    <Label fx:id="datasetLabel" text="No dataset selected" styleClass="sub-header-label" style="-fx-font-size: 12px; -fx-opacity: 0.8;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Resource Status Indicator -->
                <Label fx:id="resourceStatusLabel" text="Checking Resources..." styleClass="sub-header-label" style="-fx-font-size: 11px; -fx-padding: 5 10 5 10; -fx-background-radius: 4; -fx-background-color: #eee; -fx-text-fill: #555;"/>
                <Button text="Help" styleClass="button"/>
            </HBox>

            <!-- Dynamic Content -->
            <StackPane fx:id="mainContent" VBox.vgrow="ALWAYS">
                <padding><Insets top="20" right="30" bottom="30" left="30"/></padding>
            </StackPane>
        </VBox>
    </center>

    </BorderPane>

    <!-- Floating Chat Overlay -->
    <VBox alignment="BOTTOM_RIGHT" pickOnBounds="false" spacing="10">
        <padding><Insets bottom="20" right="20"/></padding>
        
        <!-- The Chat View Container -->
        <StackPane fx:id="chatContainer" visible="false" alignment="BOTTOM_RIGHT"/>

        <!-- Toggle Button -->
        <Button fx:id="chatToggleBtn" text="💬 AI Chat" styleClass="button-accent" style="-fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
    </VBox>

</StackPane>