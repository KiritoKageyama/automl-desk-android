<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automl_prototype_1.controller.RlLabViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Agentic RL Lab" textFill="#2c3e50">
        <font>
            <Font name="Segoe UI Semibold" size="24.0" />
        </font>
    </Label>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Environment:" />
        <ComboBox fx:id="envComboBox" prefWidth="200.0" promptText="Select Environment" />
        
        <Label text="Episodes:" />
        <TextField fx:id="episodesField" prefWidth="80.0" text="1000" />
        
        <Button fx:id="trainBtn" text="Start Training" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
        <Button fx:id="stopBtn" text="Stop" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" disable="true" />
    </HBox>

    <HBox spacing="15.0" VBox.vgrow="ALWAYS">
        <!-- Render Area -->
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="Environment Render" style="-fx-font-weight: bold;" />
            <TextArea fx:id="renderArea" editable="false" style="-fx-font-family: 'Consolas', monospace;" VBox.vgrow="ALWAYS" />
        </VBox>
        
        <!-- Logs/Status Area -->
        <VBox spacing="5.0" prefWidth="300.0">
            <Label text="Training Log" style="-fx-font-weight: bold;" />
             <TextArea fx:id="logArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>
</VBox>
