<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.automl_prototype_1.controller.CnnWorkspaceController">
    <content>
        <VBox spacing="20" style="-fx-padding: 10;">
            
            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Computer Vision (CNN) Workspace" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Images &amp; Spatial Data" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>
            </HBox>

            <!-- 1. DATA UPLOAD SECTION -->
            <VBox spacing="15" styleClass="card">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                <Label styleClass="header-label" text="1. Upload Image Dataset"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="browseFolderButton" text="Browse Image Folder..." onAction="#handleBrowseFolder"/>
                    <Label fx:id="selectedFolderLabel" text="No folder selected." wrapText="true" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Data should be structured into class folders (e.g., /cats, /dogs) or use a CSV mapping." wrapText="true" style="-fx-text-fill: #666;"/>
                
                <Separator/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="sub-header-label" text="Augmentation:"/>
                    <CheckBox fx:id="chkFlip" text="Horizontal Flip"/>
                    <CheckBox fx:id="chkRotate" text="Random Rotation"/>
                    <CheckBox fx:id="chkCrop" text="Random Crop"/>
                </HBox>
            </VBox>

            <!-- 2. CNN ARCHITECTURE -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="500.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
            
                <!-- Left: Backbone Selection -->
                <VBox spacing="15" styleClass="card" GridPane.columnIndex="0" GridPane.vgrow="ALWAYS">
                    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                    <Label styleClass="header-label" text="2. Backbone Network"/>
                    
                    <Label styleClass="sub-header-label" text="Select Pretrained CNN"/>
                    <ChoiceBox fx:id="cnnBackboneChoiceBox" maxWidth="Infinity"/>
                    
                    <Separator prefHeight="20.0"/>
                    
                    <VBox spacing="10">
                        <Label styleClass="sub-header-label" text="Transfer Learning Strategy"/>
                        <RadioButton fx:id="radFeatureExtractor" text="Feature Extractor (Freeze Backbone)"/>
                        <RadioButton fx:id="radFineTune" text="Fine-Tune (Unfreeze Last Blocks)"/>
                        <RadioButton fx:id="radTrainScratch" text="Train from Scratch"/>
                    </VBox>
                </VBox>
            
                <!-- Right: Vision Hyperparameters -->
                <VBox spacing="15" GridPane.columnIndex="1" GridPane.vgrow="ALWAYS">
                    <VBox spacing="15" styleClass="card">
                        <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                        <Label styleClass="header-label" text="3. Training Configuration"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label styleClass="sub-header-label" text="Input Image Size:"/>
                            <ChoiceBox fx:id="imageSizeChoiceBox" prefWidth="120"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label styleClass="sub-header-label" text="Batch Size:"/>
                            <TextField fx:id="batchSizeField" promptText="32" prefWidth="100"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label styleClass="sub-header-label" text="Epochs:"/>
                            <TextField fx:id="epochsField" promptText="50" prefWidth="100"/>
                        </HBox>
                        
                        <Separator prefHeight="10.0"/>
                        <Label styleClass="sub-header-label" text="Hardware Limits"/>
                        <VBox spacing="8">
                             <Label text="Vision models typically require significant VRAM." style="-fx-font-size: 11px;"/>
                             <CheckBox fx:id="chkMixedPrecision" text="Use FP16 Mixed Precision"/>
                             <CheckBox fx:id="chkUseGpu" text="Enable CUDA/MPS Hardware Acceleration"/>
                        </VBox>
                    </VBox>
                </VBox>
            </GridPane>
            <!-- 3. RUN TRAINING -->
            <VBox spacing="12" styleClass="card" VBox.vgrow="NEVER">
                <padding><Insets top="16" right="30" bottom="16" left="30"/></padding>
                <Label styleClass="header-label" text="4. Launch Training"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="runTrainingBtn" text="▶ Run Training"
                            styleClass="button-accent" onAction="#handleRunTraining"
                            style="-fx-background-color: #238636; -fx-text-fill: white; -fx-pref-width: 160; -fx-cursor: hand;"/>
                    <Button fx:id="stopTrainingBtn" text="⏹ Stop" disable="true"
                            onAction="#handleStopTraining"
                            style="-fx-background-color: #b62324; -fx-text-fill: white; -fx-pref-width: 80; -fx-cursor: hand;"/>
                    <ProgressBar fx:id="trainingProgress" progress="0" HBox.hgrow="ALWAYS" prefHeight="24"/>
                    <Label fx:id="trainingStatusLabel" text="Ready to train."
                           style="-fx-text-fill: #8b949e; -fx-font-size: 11px;" wrapText="false"/>
                </HBox>
                <TextArea fx:id="trainingLogArea" editable="false" wrapText="true" prefHeight="100"
                          promptText="Training log will appear here..."
                          style="-fx-font-family: 'Consolas'; -fx-font-size: 11px;"/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
