<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.automl_prototype_1.controller.AlgoSelectViewController">
    <content>
        <VBox spacing="20" style="-fx-padding: 10;">
            <!-- Top Section: 2 Columns -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="400.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
            
                <!-- Left Card: Primary Selections -->
                <VBox spacing="15" styleClass="card" GridPane.columnIndex="0" GridPane.vgrow="ALWAYS">
                    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                    <Label styleClass="header-label" text="2. Select Algorithms"/>
                    <CheckBox fx:id="selectAllAlgorithms" text="Select All Algorithms" style="-fx-font-weight: bold;"/>
                    <GridPane hgap="20" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                        </columnConstraints>
                        <children>
                            <CheckBox fx:id="checkBPSO" text="BPSO" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <CheckBox fx:id="checkWWO" text="WWO" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <CheckBox fx:id="checkASO" text="ASO" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <CheckBox fx:id="checkGA" text="Genetic Algorithm" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <CheckBox fx:id="checkIGPSO" text="IGPSO" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <CheckBox fx:id="checkPLS" text="Parallel Local Search" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <CheckBox fx:id="checkSA" text="Simulated Annealing" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <CheckBox fx:id="checkGWO" text="Grey Wolf Optimizer" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <CheckBox fx:id="checkDE" text="Differential Evolution" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        </children>
                    </GridPane>
                    <Separator prefHeight="20.0"/>
                    <Label styleClass="header-label" text="3. Select Base ML Model"/>
                    <ChoiceBox fx:id="baseModelChoiceBox" maxWidth="Infinity"/>
                </VBox>
            
                <!-- Right Card: Advanced Options (Without Advice) -->
                <VBox spacing="15" GridPane.columnIndex="1" GridPane.vgrow="ALWAYS">
                    <!-- Standard Advanced Options -->
                    <VBox spacing="15" styleClass="card">
                        <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                        <Label styleClass="header-label" text="Advanced Options"/>

                        <Label styleClass="sub-header-label" text="Number of Folds for Cross-Validation:"/>
                        <TextField fx:id="kFoldsTextField" promptText="e.g., 5 or 10"/>
                        <CheckBox fx:id="enableTuningCheckBox" text="Enable Hyperparameter Tuning (Slower)"/>
                
                        <Separator prefHeight="10.0"/>
                        <Label styleClass="header-label" text="Execution Settings"/>
                        <VBox spacing="8">
                             <CheckBox fx:id="chkUseGpu" text="Use GPU Acceleration"/>
                             <ComboBox fx:id="cmbGpuSelector" promptText="Select GPU Device" prefWidth="300.0" visible="false" managed="false"/>
                             <CheckBox fx:id="chkUseWsl" text="Enable WSL 2 (For RAPIDS/XGBoost)"/>
                             <CheckBox fx:id="chkBalancedOpt" text="Optimize for Balanced Accuracy"/>
                             <CheckBox fx:id="enableLoggingCheckBox" text="Enable Detailed Logging"/>
                        </VBox>
                    </VBox>

                    <!-- Experimental Control (Advanced Mode Only) -->
                    <VBox fx:id="experimentalCard" spacing="15" styleClass="card" visible="false" managed="false">
                        <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                        <Label styleClass="header-label" text="Experimental Control"/>
                        <Label text="Manual Overrides for Automated Logic" style="-fx-font-size: 11px; -fx-text-fill: gray;"/>
                        
                        <GridPane hgap="10" vgap="10">
                             <Label text="Manual Trials:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                             <TextField fx:id="manualTrialsField" promptText="Auto" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                             
                             <Label text="Max Iterations:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                             <TextField fx:id="manualIterationsField" promptText="Default" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>
                        
                        <CheckBox fx:id="forceGpuCheck" text="Force GPU (Bypass Small Data Check)" style="-fx-text-fill: #b91c1c;"/>
                    </VBox>
                </VBox>
            </GridPane>

            <!-- Bottom Card: Recommendation (Centrally Aligned & Big) -->
        <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                <Label styleClass="header-label" text="Recommendation" maxWidth="Infinity" alignment="CENTER"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="recommendButton" text="Get Advice" styleClass="button-accent"/>
                    <Button fx:id="quickScanBtn" text="⚡ Quick Scan" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <TextArea fx:id="adviceTextArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          prefHeight="200.0" minHeight="150.0"
                          promptText="Click 'Get Advice' to see recommendations based on your dataset's characteristics."/>
                <Label text="Quick Scan Results" styleClass="sub-header-label" style="-fx-font-size: 12px;"/>
                <TextArea fx:id="quickScanResultArea" editable="false" wrapText="true"
                          prefHeight="150.0" minHeight="100.0"
                          promptText="Click '⚡ Quick Scan' to empirically benchmark classifiers on a data subsample."/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>