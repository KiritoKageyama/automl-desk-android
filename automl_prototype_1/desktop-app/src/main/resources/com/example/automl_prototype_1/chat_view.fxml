<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automl_prototype_1.controller.ChatViewController"
      styleClass="chat-card"
      prefWidth="350" prefHeight="500" spacing="10">
    
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="AI Assistant" styleClass="header-label" style="-fx-font-size: 16px;"/>
        <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: green; -fx-font-size: 12px;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="X" onAction="#handleClose" style="-fx-background-color: transparent; -fx-text-fill: gray; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
    
    <!-- Chat Area -->
    <ScrollPane fx:id="scrollPane" VBox.vgrow="ALWAYS" fitToWidth="true" style="-fx-background-color: transparent;">
        <content>
            <VBox fx:id="messageContainer" spacing="10" style="-fx-padding: 10;">
                <!-- Messages will be added here dynamically -->
            </VBox>
        </content>
    </ScrollPane>
    
    <!-- Input Area -->
    <HBox spacing="5" alignment="CENTER">
        <TextArea fx:id="inputField" promptText="Ask about your data..." wrapText="true" prefHeight="40" VBox.vgrow="NEVER" HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="➤" onAction="#handleSend" styleClass="button-accent" prefWidth="40" prefHeight="40"/>
    </HBox>

</VBox>
